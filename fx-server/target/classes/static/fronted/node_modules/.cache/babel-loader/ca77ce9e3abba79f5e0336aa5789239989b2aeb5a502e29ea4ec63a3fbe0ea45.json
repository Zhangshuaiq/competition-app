{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { queryTeams } from \"@/api\";\nexport default {\n  name: \"ContestantIndex\",\n  data() {\n    return {\n      teamList: []\n    };\n  },\n  methods: {\n    queryTeamList() {\n      queryTeams().then(res => {\n        console.log(res);\n        if (res.code === 200) {\n          this.teamList = res.data;\n        }\n      });\n    },\n    enterWaitPage(teamItem, member) {\n      sessionStorage.setItem(\"user\", JSON.stringify(teamItem));\n      sessionStorage.setItem(\"member\", member);\n      console.log(teamItem);\n      this.$router.push({\n        name: \"wait\"\n      });\n    }\n  },\n  mounted() {\n    this.queryTeamList();\n  }\n};","map":{"version":3,"names":["queryTeams","name","data","teamList","methods","queryTeamList","then","res","console","log","code","enterWaitPage","teamItem","member","sessionStorage","setItem","JSON","stringify","$router","push","mounted"],"sources":["src/components/ContestantIndex.vue"],"sourcesContent":["<!--  选手页面 -->\r\n<template>\r\n  <div id=\"container-box\">\r\n    <div id=\"container\">\r\n      <el-row>\r\n        <el-col v-for=\"(item, index) in teamList\"\r\n                :key=\"index\"\r\n                span=6\r\n        >\r\n          <div style=\"height: 160px\">\r\n            <div class=\"haotai\" >\r\n              {{item.shortName}}\r\n            </div>\r\n            <div style=\"display: flex; justify-content: center; height: 60px; line-height: 60px\">\r\n              ` <div v-if=\"!item.members\"></div>\r\n                <div v-else v-for=\"(member, mIndex) in item.members.split(',')\" @click=\"enterWaitPage(item, member)\"\r\n                     :key=\"mIndex\" class=\"member\">\r\n                  {{member}}\r\n                </div>\r\n            </div>\r\n          </div>\r\n\r\n        </el-col>\r\n      </el-row>\r\n    </div>\r\n  </div>\r\n  \r\n</template>\r\n\r\n<script>\r\nimport {queryTeams} from \"@/api\";\r\n\r\nexport default {\r\n  name: \"ContestantIndex\",\r\n  \r\n  data() {\r\n    return {\r\n      teamList: []\r\n    }\r\n  },\r\n  \r\n  methods: {\r\n    queryTeamList(){\r\n      queryTeams().then(res => {\r\n        console.log(res)\r\n        if (res.code === 200) {\r\n          this.teamList = res.data\r\n        }\r\n      })\r\n    },\r\n\r\n    enterWaitPage(teamItem, member){\r\n      sessionStorage.setItem(\"user\", JSON.stringify(teamItem))\r\n      sessionStorage.setItem(\"member\", member)\r\n      console.log(teamItem)\r\n      this.$router.push({name: \"wait\"});\r\n    }\r\n  },\r\n  \r\n  mounted() {\r\n    this.queryTeamList()\r\n  }\r\n\r\n\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n#container-box {\r\n  background-image: url(\"~@/assets/background.png\");\r\n  background-size: 100vw 100vh;\r\n  height: 100vh;\r\n}\r\n\r\n#container {\r\n  padding: 100px;\r\n}\r\n\r\n.haotai {\r\n  margin-top: 40px;\r\n  margin: 0 30px;\r\n  text-align: center;\r\n  color: red;\r\n  height: 60px;\r\n  line-height: 60px;\r\n  font-size: xx-large;\r\n  border-width: 1px;\r\n  border-color: black;\r\n  background-color: white;\r\n  border-radius: 20px;\r\n}\r\n\r\n\r\n.haotai:hover {\r\n  background-color: #000000; /* 鼠标悬停时的背景颜色 */\r\n  color: #ffffff;\r\n}\r\n\r\n.member {\r\n  border-color: black;\r\n  margin: 20px 10px;\r\n  width: 50px;\r\n  padding: 0 10px;\r\n  color: white;\r\n  line-height: 60px;\r\n  background-color: #ff9900;\r\n  text-align: center;\r\n  height: 60px;\r\n}\r\n\r\n.member:hover {\r\n  background-color: #000000; /* 鼠标悬停时的背景颜色 */\r\n  color: #ffffff;\r\n}\r\n</style>"],"mappings":";AA8BA,SAAAA,UAAA;AAEA;EACAC,IAAA;EAEAC,KAAA;IACA;MACAC,QAAA;IACA;EACA;EAEAC,OAAA;IACAC,cAAA;MACAL,UAAA,GAAAM,IAAA,CAAAC,GAAA;QACAC,OAAA,CAAAC,GAAA,CAAAF,GAAA;QACA,IAAAA,GAAA,CAAAG,IAAA;UACA,KAAAP,QAAA,GAAAI,GAAA,CAAAL,IAAA;QACA;MACA;IACA;IAEAS,cAAAC,QAAA,EAAAC,MAAA;MACAC,cAAA,CAAAC,OAAA,SAAAC,IAAA,CAAAC,SAAA,CAAAL,QAAA;MACAE,cAAA,CAAAC,OAAA,WAAAF,MAAA;MACAL,OAAA,C