{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"Model60M\",\n  data() {\n    return {\n      subscription: null,\n      questionItem: null,\n      activeDiv: '',\n      teamInfo: '',\n      second: -1,\n      showResult: false,\n      showWait: true\n    };\n  },\n  methods: {\n    submitAnswer() {\n      // 提交答案到后台\n      console.log(this.activeDiv);\n      this.showResult = true;\n      const submited = JSON.parse(JSON.stringify(this.questionItem));\n      this.saveData();\n      // 队伍名称, 题目分值\n      submited.teamName = this.teamInfo.fullName;\n      submited.userSelect = this.activeDiv;\n      // 题目列表\n      console.log(submited);\n      //  提交答案\n      this.$websocket.send('/app/model60/submit', {\n        data: JSON.stringify(submited)\n      });\n    },\n    saveData() {\n      sessionStorage.setItem(\"showResult\", this.showResult + \"\");\n      sessionStorage.setItem(\"showWait\", this.showWait + \"\");\n      sessionStorage.setItem(\"questionItem\", JSON.stringify(this.questionItem));\n    },\n    loadData() {\n      const wait = sessionStorage.getItem(\"showWait\");\n      if (wait && wait !== 'null') {\n        this.showWait = wait === 'true';\n      }\n      const result = sessionStorage.getItem(\"showResult\");\n      if (result && result !== 'null') {\n        this.showResult = result === 'true';\n      }\n      const item = sessionStorage.getItem(\"questionItem\");\n      if (item && item !== 'null') {\n        this.questionItem = JSON.parse(item);\n      }\n      console.log(this.questionItem);\n    },\n    setActiveDiv(divNumber) {\n      this.activeDiv = divNumber;\n    },\n    subscribeQuestion() {\n      this.subscription = this.$websocket.subscribe('/topic/question', message => {\n        if (message.type === 'time') {\n          console.log(message.data);\n          this.second = parseInt(message.data);\n          if (this.second <= 0) {\n            if (this.showResult === false) {\n              this.activeDiv = '';\n              this.submitAnswer();\n            }\n          }\n        } else {\n          this.questionItem = message.data;\n          this.questionItem.teamName = this.teamInfo.fullName;\n          this.activeDiv = '';\n          this.showResult = false;\n          this.showWait = false;\n          this.saveData();\n        }\n      });\n      this.$websocket.subscribe('/topic/model60/start', message => {\n        console.log(message);\n        this.showWait = false;\n        this.saveData();\n      });\n    }\n  },\n  mounted() {\n    const item = sessionStorage.getItem(\"user\");\n    if (!item) {\n      this.$router.push({\n        name: \"contestant\"\n      });\n      return;\n    }\n    this.teamInfo = JSON.parse(item);\n    console.log(this.teamInfo);\n    this.loadData();\n    this.subscribeQuestion();\n  },\n  beforeDestroy() {\n    if (this.$websocket) {\n      if (this.subscription) {\n        this.$websocket.unsubscribe(this.subscription);\n      }\n      this.$websocket.disconnect();\n    }\n  }\n};","map":{"version":3,"names":["name","data","subscription","questionItem","activeDiv","teamInfo","second","showResult","showWait","methods","submitAnswer","console","log","submited","JSON","parse","stringify","saveData","teamName","fullName","userSelect","$websocket","send","sessionStorage","setItem","loadData","wait","getItem","result","item","setActiveDiv","divNumber","subscribeQuestion","subscribe","message","type","parseInt","mounted","$router","push","beforeDestroy","unsubscribe","disconnect"],"sources":["src/components/Model60.vue"],"sourcesContent":["<template>\r\n  <div id=\"container-box\">\r\n    <div id=\"container\">\r\n      <div id=\"question-info\"  v-if=\"questionItem\">\r\n        <div v-if=\"second >= 0\" style=\"font-size: xx-large; color: red\">\r\n          剩余时间: {{second}} 秒\r\n        </div>\r\n        <div id=\"question-name\">\r\n          {{ questionItem.questionNumber }} &nbsp;&nbsp; {{ questionItem.question }}\r\n        </div>\r\n        <div id=\"answer-selection\">\r\n          <div class=\"selection-item\"  v-if=\"questionItem.choiceA\">\r\n            A . {{questionItem.choiceA}}\r\n          </div>\r\n\r\n          <div class=\"selection-item\"  v-if=\"questionItem.choiceB\">\r\n            B . {{questionItem.choiceB}}\r\n          </div>\r\n\r\n          <div class=\"selection-item\"  v-if=\"questionItem.choiceC\">\r\n            C . {{questionItem.choiceC}}\r\n          </div>\r\n\r\n          <div class=\"selection-item\"  v-if=\"questionItem.choiceD\">\r\n            D . {{questionItem.choiceD}}\r\n          </div>\r\n\r\n          <div class=\"selection-item\"  v-if=\"questionItem.choiceE\">\r\n            E . {{questionItem.choiceE}}\r\n          </div>\r\n\r\n          <div class=\"selection-item\"  v-if=\"questionItem.choiceF\">\r\n            F . {{questionItem.choiceF}}\r\n          </div>\r\n        </div>\r\n        <br>\r\n        <div>\r\n          <el-row>\r\n            <el-col span=\"4\">\r\n              <div class=\"answer-item\" :class=\"{ 'blue-background': activeDiv === 'A' }\" @click=\"setActiveDiv('A')\" v-if=\"questionItem.choiceA\">\r\n                A\r\n              </div>\r\n            </el-col>\r\n            <el-col span=\"4\">\r\n              <div class=\"answer-item\" :class=\"{ 'blue-background': activeDiv === 'B' }\" @click=\"setActiveDiv('B')\" v-if=\"questionItem.choiceB\">\r\n                B\r\n              </div>\r\n            </el-col>\r\n            <el-col span=\"4\">\r\n              <div class=\"answer-item\" :class=\"{ 'blue-background': activeDiv === 'C' }\" @click=\"setActiveDiv('C')\" v-if=\"questionItem.choiceC\">\r\n                C\r\n              </div>\r\n\r\n            </el-col>\r\n            <el-col span=\"4\">\r\n              <div class=\"answer-item\" :class=\"{ 'blue-background': activeDiv === 'D' }\" @click=\"setActiveDiv('D')\" v-if=\"questionItem.choiceD\">\r\n                D\r\n              </div>\r\n            </el-col>\r\n            <el-col span=\"4\">\r\n              <div class=\"answer-item\" :class=\"{ 'blue-background': activeDiv === 'E' }\" @click=\"setActiveDiv('E')\" v-if=\"questionItem.choiceE\">\r\n                E\r\n              </div>\r\n            </el-col>\r\n            <el-col span=\"4\">\r\n              <div class=\"answer-item\" :class=\"{ 'blue-background': activeDiv === 'F' }\" @click=\"setActiveDiv('F')\" v-if=\"questionItem.choiceF\">\r\n                F\r\n              </div>\r\n            </el-col>\r\n          </el-row>\r\n        </div>\r\n        <div v-if=\"questionItem\" style=\"text-align: center; margin-top: 20px\">\r\n          <el-button :disabled=\"second <= 0 || showResult\" style=\"width: 200px; height: 50px; font-size: x-large\" type=\"primary\" @click=\"submitAnswer\"> 确 认 </el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <div v-if=\"showWait\" style=\"text-align: center; padding: 0 100px\">\r\n        <div class=\"result-info\">\r\n\r\n        </div>\r\n        <div class=\"result-info\">\r\n          等待答题\r\n        </div>\r\n\r\n        <div class=\"result-info\">\r\n\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Model60M\",\r\n  data(){\r\n    return {\r\n      subscription: null,\r\n      questionItem: null,\r\n      activeDiv: '',\r\n      teamInfo: '',\r\n      second: -1,\r\n      showResult: false,\r\n      showWait: true,\r\n    }\r\n  },\r\n  methods: {\r\n    submitAnswer(){\r\n      // 提交答案到后台\r\n      console.log(this.activeDiv)\r\n      this.showResult = true;\r\n      const submited = JSON.parse(JSON.stringify(this.questionItem))\r\n      this.saveData()\r\n      // 队伍名称, 题目分值\r\n      submited.teamName =  this.teamInfo.fullName\r\n      submited.userSelect = this.activeDiv\r\n      // 题目列表\r\n      console.log(submited)\r\n      //  提交答案\r\n      this.$websocket.send('/app/model60/submit', {\r\n        data: JSON.stringify(submited),\r\n      })\r\n    },\r\n\r\n\r\n    saveData(){\r\n      sessionStorage.setItem(\"showResult\", this.showResult + \"\")\r\n      sessionStorage.setItem(\"showWait\", this.showWait + \"\")\r\n      sessionStorage.setItem(\"questionItem\", JSON.stringify(this.questionItem))\r\n    },\r\n\r\n    loadData(){\r\n      const wait = sessionStorage.getItem(\"showWait\")\r\n      if (wait && wait !== 'null') {\r\n        this.showWait = wait === 'true'\r\n      }\r\n\r\n      const result = sessionStorage.getItem(\"showResult\")\r\n      if (result && result !== 'null') {\r\n        this.showResult = result === 'true'\r\n      }\r\n\r\n      const item = sessionStorage.getItem(\"questionItem\");\r\n      if (item && item !== 'null') {\r\n        this.questionItem = JSON.parse(item)\r\n      }\r\n      console.log(this.questionItem)\r\n    },\r\n\r\n\r\n    setActiveDiv(divNumber) {\r\n      this.activeDiv = divNumber;\r\n    },\r\n\r\n    subscribeQuestion(){\r\n      this.subscription = this.$websocket.subscribe('/topic/question', (message) => {\r\n        if (message.type === 'time') {\r\n          console.log(message.data)\r\n          this.second = parseInt(message.data)\r\n          if (this.second <= 0) {\r\n            if (this.showResult === false) {\r\n              this.activeDiv = ''\r\n              this.submitAnswer()\r\n            }\r\n          }\r\n        } else {\r\n          this.questionItem = message.data\r\n          this.questionItem.teamName = this.teamInfo.fullName\r\n          this.activeDiv = ''\r\n          this.showResult = false\r\n          this.showWait = false\r\n          this.saveData()\r\n        }\r\n\r\n      })\r\n\r\n      this.$websocket.subscribe('/topic/model60/start', (message) => {\r\n        console.log(message)\r\n        this.showWait = false\r\n        this.saveData()\r\n      })\r\n    },\r\n  },\r\n\r\n  mounted() {\r\n    const item = sessionStorage.getItem(\"user\");\r\n    if (!item) {\r\n      this.$router.push({name: \"contestant\"})\r\n      return\r\n    }\r\n    this.teamInfo = JSON.parse(item)\r\n    console.log(this.teamInfo)\r\n    this.loadData();\r\n    this.subscribeQuestion()\r\n  },\r\n\r\n  beforeDestroy() {\r\n    if (this.$websocket) {\r\n      if (this.subscription) {\r\n        this.$websocket.unsubscribe(this.subscription)\r\n      }\r\n      this.$websocket.disconnect()\r\n    }\r\n  },\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n#container-box {\r\n  background-image: url(\"~@/assets/background.png\");\r\n  background-size: 100vw 100vh;\r\n  height: 100vh;\r\n}\r\n\r\n#container {\r\n  padding: 50px 100px;\r\n}\r\n\r\n#question-name {\r\n  font-family: \"Microsoft YaHei UI\";\r\n  font-size: xx-large;\r\n}\r\n\r\n#answer-selection {\r\n  margin-top: 20px;\r\n  font-family: \"Microsoft YaHei UI\";\r\n  font-size: x-large;\r\n}\r\n\r\n.selection-item {\r\n  padding: 5px ;\r\n}\r\n\r\n.answer-item {\r\n  height: 60px;\r\n  width: 60px;\r\n  line-height: 60px;\r\n  text-align: center;\r\n  font-size: xxx-large;\r\n  background-color: white;\r\n}\r\n\r\n.blue-background {\r\n  background-color: skyblue;\r\n}\r\n\r\n.result-info {\r\n  margin: 50px;\r\n  font-size: xx-large;\r\n}\r\n</style>"],"mappings":";AA8FA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,YAAA;MACAC,SAAA;MACAC,QAAA;MACAC,MAAA;MACAC,UAAA;MACAC,QAAA;IACA;EACA;EACAC,OAAA;IACAC,aAAA;MACA;MACAC,OAAA,CAAAC,GAAA,MAAAR,SAAA;MACA,KAAAG,UAAA;MACA,MAAAM,QAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,MAAAb,YAAA;MACA,KAAAc,QAAA;MACA;MACAJ,QAAA,CAAAK,QAAA,QAAAb,QAAA,CAAAc,QAAA;MACAN,QAAA,CAAAO,UAAA,QAAAhB,SAAA;MACA;MACAO,OAAA,CAAAC,GAAA,CAAAC,QAAA;MACA;MACA,KAAAQ,UAAA,CAAAC,IAAA;QACArB,IAAA,EAAAa,IAAA,CAAAE,SAAA,CAAAH,QAAA;MACA;IACA;IAGAI,SAAA;MACAM,cAAA,CAAAC,OAAA,oBAAAjB,UAAA;MACAgB,cAAA,CAAAC,OAAA,kBAAAhB,QAAA;MACAe,cAAA,CAAAC,OAAA,iBAAAV,IAAA,CAAAE,SAAA,MAAAb,YAAA;IACA;IAEAsB,SAAA;MACA,MAAAC,IAAA,GAAAH,cAAA,CAAAI,OAAA;MACA,IAAAD,IAAA,IAAAA,IAAA;QACA,KAAAlB,QAA